rules_version = '2';

/*
  CheckCheck security rules.

  Two worlds:

    users/{uid}/**        Everything private. Unchanged from before.
    lists/{listId}/**     Shared shopping lists. Only exists once you share.
    invites/{code}        Maps a share code to a list id.

  The interesting problem is JOINING. A person who has been given a code is
  not yet a member, so they cannot read the list — but they need to add
  themselves to it. Resolving that without Cloud Functions (which would mean
  a billing account) needs two things:

    1. invites/{code} is readable by any signed-in user, because knowing the
       code IS the secret. Crucially only `get` is allowed, never `list` —
       otherwise anyone could enumerate every invite in the database and join
       every list.

    2. A second, tightly scoped update rule on the list that lets a
       non-member add EXACTLY THEMSELVES and nothing else. It cannot touch
       the items, cannot remove anyone, cannot add a third party, and cannot
       change the owner.
*/

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Private per-user data (unchanged) ────────────────────────────────
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // ── Shared shopping lists ────────────────────────────────────────────
    match /lists/{listId} {

      function signedIn() {
        return request.auth != null;
      }
      function isMember() {
        return signedIn() && request.auth.uid in resource.data.memberIds;
      }
      function isOwner() {
        return signedIn() && request.auth.uid == resource.data.ownerUid;
      }

      allow get, list: if isMember();

      // You may only create a list you own and are the sole member of.
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.memberIds == [request.auth.uid];

      // Members may edit the list, but nobody can reassign ownership and
      // no member can quietly promote themselves by rewriting ownerUid.
      allow update: if isMember()
        && request.resource.data.ownerUid == resource.data.ownerUid;

      // JOIN. A non-member with a valid code adds only themselves.
      // Every clause here is load-bearing:
      //   hasOnly      — cannot smuggle in an edit to any other field
      //   hasAll       — cannot drop an existing member
      //   size() + 1   — exactly one addition, not several
      //   uid in new   — the addition is themselves, not someone else
      allow update: if signedIn()
        && !(request.auth.uid in resource.data.memberIds)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds', 'members'])
        && request.resource.data.memberIds.hasAll(resource.data.memberIds)
        && request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1
        && request.auth.uid in request.resource.data.memberIds
        && request.resource.data.ownerUid == resource.data.ownerUid;

      // Only the owner can delete the list outright.
      allow delete: if isOwner();

      // ── Items ──────────────────────────────────────────────────────────
      // One document per item. This is the whole point: two people editing
      // different items never touch the same document, so neither can
      // overwrite the other.
      match /items/{itemId} {
        function parentMembers() {
          return get(/databases/$(database)/documents/lists/$(listId)).data.memberIds;
        }
        allow read, write: if request.auth != null
          && request.auth.uid in parentMembers();
      }
    }

    // ── Invite codes ─────────────────────────────────────────────────────
    // `get` only — never `list`. With list access, anyone could read every
    // invite document and join every shared list in the app.
    match /invites/{code} {
      allow get: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid;
      allow delete: if request.auth != null
        && resource.data.ownerUid == request.auth.uid;
    }
  }
}
